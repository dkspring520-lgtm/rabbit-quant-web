# Optional generic JSON webhook for deploy/backup success and failure events.
RABBIT_QUANT_ALERT_WEBHOOK_URL=

# Keep the newest release images while preserving active and rollback images.
RABBIT_QUANT_IMAGE_RETENTION=5

# Local verified backup retention.
RABBIT_QUANT_BACKUP_DIR=/opt/rabbit-quant-backups
RABBIT_QUANT_BACKUP_RETENTION_DAYS=14
RABBIT_QUANT_CONTROL_CONTAINER=rabbit-quant-control
RABBIT_QUANT_CONTROL_DB_PATH=/data/rabbit-control.sqlite

# Optional content automation. Set the key on the VPS to enable AI long-form generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Baidu active push. Put the verified site's token here on the VPS; never commit the real token.
BAIDU_SUBMIT_SITE=https://www.zhuandianmi.com
BAIDU_SUBMIT_TOKEN=
BAIDU_SUBMIT_ENDPOINT=http://data.zz.baidu.com/urls

# Optional encrypted offsite backups. Never point this at the public source repo.
RABBIT_QUANT_BACKUP_GIT_REMOTE=
RABBIT_QUANT_BACKUP_GIT_BRANCH=encrypted-snapshots
RABBIT_QUANT_BACKUP_GIT_RETENTION_DAYS=7
RABBIT_QUANT_BACKUP_PASSPHRASE_FILE=/etc/rabbit-quant-backup.passphrase
