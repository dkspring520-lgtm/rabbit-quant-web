[Unit]
Description=Rabbit Growth daily content generation
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/rabbit-quant-ops
ExecStart=/bin/sh -lc 'for container in rabbit-quant-modern-web rabbit-quant-modern-web-green; do if docker ps --filter name=$container --quiet | grep -q .; then exec docker exec "$container" node scripts/growth-daily.mjs; fi; done; echo "没有运行中的网站容器" >&2; exit 1'
TimeoutStartSec=10min
Nice=10

[Install]
WantedBy=multi-user.target
