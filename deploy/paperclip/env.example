# Copy to deploy/paperclip/.env and replace every placeholder before validation.
PAPERCLIP_BIND_HOST=127.0.0.1
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

PAPERCLIP_BRIDGE_BIND_HOST=127.0.0.1
PAPERCLIP_BRIDGE_PORT=3210
PAPERCLIP_BRIDGE_CONFIG_ROOT=./config
PAPERCLIP_DATASET_ROOT=/srv/rabbit-quant-research/datasets

# Exact 40-character commit used to build this Bridge image.
APP_COMMIT_SHA=REPLACE_WITH_GIT_REV_PARSE_HEAD
