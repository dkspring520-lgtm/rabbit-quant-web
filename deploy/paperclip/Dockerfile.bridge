FROM node:22.13.1-alpine

ARG APP_COMMIT_SHA=unknown

WORKDIR /app

COPY lib/factor-research ./lib/factor-research
COPY lib/indicators/causal-kdj.mjs ./lib/indicators/causal-kdj.mjs
COPY lib/personal-replay-training.mjs lib/qmt-orderflow-confirmation.mjs ./lib/
COPY scripts/run-factor-research.mjs ./scripts/run-factor-research.mjs
COPY services/paperclip-bridge ./services/paperclip-bridge

# COPY preserves restrictive source modes (for example a staging umask of 077).
# Normalize only public source inside the image before dropping to USER bridge.
RUN chmod 0755 /app \
  && find /app/lib /app/scripts /app/services -type d -exec chmod 0755 {} + \
  && find /app/lib /app/scripts /app/services -type f -exec chmod 0644 {} +

RUN addgroup -S -g 10001 bridge \
  && adduser -S -D -H -u 10001 -G bridge bridge \
  && mkdir -p /artifacts /state \
  && chown -R bridge:bridge /artifacts /state

ENV NODE_ENV=production \
  FACTOR_RESEARCH_GIT_COMMIT=${APP_COMMIT_SHA} \
  PAPERCLIP_BRIDGE_HOST=0.0.0.0 \
  PAPERCLIP_BRIDGE_PORT=3210

USER bridge

EXPOSE 3210

CMD ["node", "services/paperclip-bridge/server.mjs"]
