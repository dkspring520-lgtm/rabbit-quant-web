FROM node:22-bookworm-slim AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS build

# Keep release metadata after the dependency layer.  The commit and build time
# change on every deploy, but should not force npm ci to run again.
ARG APP_COMMIT_SHA=development
ARG APP_BUILD_TIME=unknown
ENV APP_COMMIT_SHA=${APP_COMMIT_SHA}
ENV APP_BUILD_TIME=${APP_BUILD_TIME}
ENV NEXT_PUBLIC_APP_COMMIT_SHA=${APP_COMMIT_SHA}
ENV NEXT_PUBLIC_APP_BUILD_TIME=${APP_BUILD_TIME}

COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runtime

ARG APP_COMMIT_SHA=development
ARG APP_BUILD_TIME=unknown
ENV NODE_ENV=production
ENV APP_COMMIT_SHA=${APP_COMMIT_SHA}
ENV APP_BUILD_TIME=${APP_BUILD_TIME}
WORKDIR /app
# Keep the large dependency tree in a stable layer. Routine page, style, and
# server-script changes then add only small layers to the new image.
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json package-lock.json ./
COPY app ./app
COPY db ./db
COPY lib ./lib
COPY public ./public
COPY scripts ./scripts
COPY server ./server
COPY worker ./worker
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=8s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/control/version').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["npm", "start", "--", "-p", "3000", "-H", "0.0.0.0"]
