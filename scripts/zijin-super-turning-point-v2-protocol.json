{
  "schemaVersion": 1,
  "experimentId": "zijin-causal-super-extreme-v2",
  "stock": { "code": "601899", "name": "紫金矿业" },
  "purpose": "只研究紫金矿业日内极端位置后的因果反转，不改动 V4 正式策略。",
  "isolation": {
    "affectsSmartTV4": false,
    "automaticPromotion": false,
    "researchOnly": true
  },
  "dataPolicy": {
    "development": ["2022-01-01", "2024-12-31"],
    "validation": ["2025-01-01", "2025-12-31"],
    "sealedBlindYear": 2026,
    "maximumLoadedDate": "2025-12-31"
  },
  "causality": {
    "signalTimestamp": "confirmation-minute",
    "earliestFill": "next-minute-open",
    "backfillSignalToHistoricalExtreme": false,
    "futureDailyHighLowAllowedAsFeature": false,
    "dailyHighLowUse": "outcome-diagnostic-only"
  },
  "signalPolicy": {
    "earliestMinute": "09:45",
    "latestMinute": "13:30",
    "minimumScore": 90,
    "minimumObservedRangePct": 1.2,
    "trailingExtremeWindowMinutes": 20,
    "minimumSignalCooldownMinutes": 60,
    "maximumSignalsPerDirectionPerDay": 1
  },
  "outcomePolicy": {
    "fixedHoldingMinutes": [20, 30, 60],
    "roundTripCostPct": 0.12,
    "positiveDefinition": "next-minute-open buy, fixed-horizon close sell",
    "reverseDefinition": "confirmation sell, next-minute-open reference, fixed-horizon lower-price buyback",
    "intrabarHighLowUse": "MFE/MAE and extreme-distance diagnostics only"
  }
}
