  "actionDefinitions": {
    "WAIT": {
      "formula": "value = 0; opportunity cost is reported separately and is not assigned to WAIT",
      "requiredInputs": [
        "timestamp"
      ],
      "futureInputs": [],
      "portfolioInputs": [],
      "costInputs": [],
      "economicInterpretation": "Hold the standardized notional in cash; no market return is claimed.",
      "provenanceStatus": "PASS"
    },
    "BUY_SMALL": {
      "formula": "gross = 0.5 * futureReturn + 0.25 * actionMFE + 0.25 * actionMAE; net = gross - 0.5 * (commission + slippage)",
      "requiredInputs": [
        "price at T",
        "future price path",
        "standardized notional unit"
      ],
      "futureInputs": [
        "futureReturn",
        "futureMFE",
        "futureMAE"
      ],
      "portfolioInputs": [
        "cash required for execution; absent from this market-conditional audit"
      ],
      "costInputs": [
        "commission",
        "slippage"
      ],
      "economicInterpretation": "Half of one declared normalized notional unit, not unlimited capital.",
      "provenanceStatus": "MARKET_VALUE_ONLY"
    },
    "BUY": {
      "formula": "gross = 1.0 * futureReturn + 0.25 * actionMFE + 0.25 * actionMAE; net = gross - 1.0 * (commission + slippage)",
      "requiredInputs": [
        "price at T",
        "future price path",
        "standardized notional unit"
      ],
      "futureInputs": [
        "futureReturn",
        "futureMFE",
        "futureMAE"
      ],
      "portfolioInputs": [
        "cash required for execution; absent from this market-conditional audit"
      ],
      "costInputs": [
        "commission",
        "slippage"
      ],
      "economicInterpretation": "One declared normalized notional unit, not unlimited capital.",
      "provenanceStatus": "MARKET_VALUE_ONLY"
    },
    "SELL_PART": {
      "formula": "undefined without an existing long position and a specified sellable fraction",
      "requiredInputs": [
        "price at T",
        "position",
        "sellablePosition",
        "partial fraction"
      ],
      "futureInputs": [
        "futureReturn",
        "futureMFE",
        "futureMAE"
      ],
      "portfolioInputs": [
        "position",
        "sellablePosition",
        "T+1 inventory"
      ],
      "costInputs": [
        "commission",
        "slippage"
      ],
      "economicInterpretation": "Partial reduction of an existing long; cannot be represented by simply negating futureReturn.",
      "provenanceStatus": "PORTFOLIO_CONTEXT_REQUIRED"
    },
    "SELL_ALL": {
      "formula": "undefined without an existing long position and sellable quantity",
      "requiredInputs": [
        "price at T",
        "position",
        "sellablePosition"
      ],
      "futureInputs": [
        "futureReturn",
        "futureMFE",
        "futureMAE"
      ],
      "portfolioInputs": [
        "position",
        "sellablePosition",
        "T+1 inventory"
      ],
      "costInputs": [
        "commission",
        "slippage"
      ],
      "economicInterpretation": "Liquidation of an existing long; invalid when no position context exists.",
      "provenanceStatus": "PORTFOLIO_CONTEXT_REQUIRED"
    }
  },
